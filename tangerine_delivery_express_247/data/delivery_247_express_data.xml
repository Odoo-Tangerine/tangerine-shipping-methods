<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="product_product_delivery_247_express" model="product.product">
            <field name="name">Delivery charges</field>
            <field name="default_code">247 Express</field>
            <field name="type">service</field>
            <field name="categ_id" ref="delivery.product_category_deliveries"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="invoice_policy">order</field>
        </record>

        <record id="tangerine_delivery_express_247_provider" model="delivery.carrier">
            <field name="name">247 Express</field>
            <field name="fixed_price">0.0</field>
            <field name="free_over" eval="False"/>
            <field name="invoice_policy">real</field>
            <field name="sequence">2</field>
            <field name="delivery_type">express_247</field>
            <field name="domain">https://customerapi-dev.247tech.xyz</field>
            <field name="product_id" ref="tangerine_delivery_express_247.product_product_delivery_247_express"/>
            <field name="is_locally_delivery" eval="True"/>
            <field name="is_support_feature_print_order" eval="True"/>
            <field name="base_weight_unit">KG</field>
        </record>

        <function model="delivery.carrier" name="set_webhook_url">
            <value eval="[ref('tangerine_delivery_express_247_provider')]"/>
        </function>
    </data>
</odoo>