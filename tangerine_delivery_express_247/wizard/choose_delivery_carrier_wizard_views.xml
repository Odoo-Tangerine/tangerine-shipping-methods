<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_choose_delivery_carrier_form_with_provider_express_247" model="ir.ui.view">
        <field name="name">view.choose.delivery.carrier.form.with.provider.express.247</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form" />
        <field name="arch" type="xml">
            <field name="carrier_id" position="after">
                <field name="express_247_service_type_id"
                       invisible="delivery_type != 'express_247'"
                       required="delivery_type == 'express_247'"
                />
            </field>
        </field>
    </record>
</odoo>
