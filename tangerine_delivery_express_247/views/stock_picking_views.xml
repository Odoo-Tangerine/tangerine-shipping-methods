<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form_inherit_delivery_express_247" model="ir.ui.view">
        <field name="name">view.picking.withcarrier.out.form.inherit.delivery.express.247</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="tangerine_delivery_base.view_picking_withcarrier_out_form_inherit_delivery_base"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='external_delivery_data']" position="before">
                <group name='delivery_express_247_data'
                       invisible="carrier_tracking_ref or not is_locally_delivery or delivery_type != 'express_247'"
                       string="247 Express Shipping Information"
                >
                    <label for="cash_on_delivery" name="o_label_cash_on_delivery"/>
                    <div class="o_row" name="o_div_cash_on_delivery">
                        <field name="cash_on_delivery" style="max-width: 15%;" widget="boolean_toggle" readonly="carrier_tracking_ref"/>
                        <field name="cash_on_delivery_amount" readonly="carrier_tracking_ref" invisible="not cash_on_delivery"/>
                    </div>
                    <field name="express_247_is_inspection_goods_allowed"
                           widget="boolean_toggle"
                           invisible="not cash_on_delivery"
                    />
                    <field name="express_247_service_type_id"
                           required="delivery_type == 'express_247'"
                    />
                    <field name="express_247_special_service_type_ids"
                           widget="many2many_tags"
                           options="{'no_create_edit': True}"
                    />
                    <field name="express_247_product_type"/>
                    <field name="remarks"/>
                </group>
            </xpath>
            <xpath expr="//button[@name='action_print_order']" position="attributes">
                <attribute name="invisible">delivery_type == 'express_247'</attribute>
            </xpath>
        </field>
    </record>
</odoo>