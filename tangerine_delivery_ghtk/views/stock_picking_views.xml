<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form_inherit_delivery_ghtk" model="ir.ui.view">
        <field name="name">view.picking.withcarrier.out.form.inherit.delivery.ghtk</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="tangerine_delivery_base.view_picking_withcarrier_out_form_inherit_delivery_base"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='external_delivery_data']" position="before">
                <group name='delivery_ghtk_data'
                       invisible="carrier_tracking_ref or not is_locally_delivery or delivery_type != 'ghtk'"
                       string="GHTK Shipping Information"
                >
                    <label for="cash_on_delivery" name="o_label_cash_on_delivery"/>
                    <div class="o_row" name="o_div_cash_on_delivery">
                        <field name="cash_on_delivery" style="max-width: 15%;" widget="boolean_toggle" readonly="carrier_tracking_ref"/>
                        <field name="cash_on_delivery_amount" readonly="carrier_tracking_ref" invisible="not cash_on_delivery"/>
                    </div>
                    <field name="ghtk_transport_type" required="delivery_type == 'ghtk'"/>
                    <field name="ghtk_service_type" required="delivery_type == 'ghtk'"/>
                    <field name="ghtk_payer_type" required="delivery_type == 'ghtk'"/>
                    <field name="ghtk_special_service_type_ids"
                           widget="many2many_tags"
                           options="{'no_create_edit': True}"
                    />
                    <label for="schedule_order" name="o_label_schedule_order"/>
                    <div class="o_row" name="o_schedule_order">
                        <field name="schedule_order" style="max-width: 15%;" widget="boolean_toggle" readonly="carrier_tracking_ref"/>
                        <field name="schedule_pickup_time_to"
                               invisible="not schedule_order"
                               required="schedule_order"
                               readonly="carrier_tracking_ref"
                        />
                    </div>
                    <field name="deliver_order_date"/>
                    <field name="remarks"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>