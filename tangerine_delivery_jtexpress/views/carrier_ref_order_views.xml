<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="carrier_ref_order_form_view_inherit_jtexpress" model="ir.ui.view">
        <field name="name">carrier.ref.order.form.view.jtexpress</field>
        <field name="model">carrier.ref.order</field>
        <field name="inherit_id" ref="tangerine_delivery_base.carrier_ref_order_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='delivery_information_service']" position="after">
                <group name="carrier_ref_order_jtexpress_detail"
                       string="J&amp;T Express Details"
                       invisible="delivery_type != 'jtexpress'"
                >
                    <field name="jtexpress_goods_type" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
