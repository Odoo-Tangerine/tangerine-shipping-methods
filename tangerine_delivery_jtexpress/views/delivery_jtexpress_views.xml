<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_delivery_carrier_form_with_provider_jtexpress" model="ir.ui.view">
        <field name="name">delivery.carrier.form.provider.jtexpress</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="tangerine_delivery_base.view_delivery_carrier_form_with_provider_delivery_base"/>
        <field name="arch" type="xml">

            <!-- API Connection Block -->
            <xpath expr="//group[@name='delivery_api_connect_information']" position="before">
                <group string="API Connect Information"
                       invisible="delivery_type != 'jtexpress'"
                       name="delivery_jtexpress_api_connect_information"
                >
                    <label for="domain"/>
                    <div class="o_row api_config_group">
                        <field name="domain"/>
                        <button name="action_test_connection"
                                string="Test Connection"
                                icon="fa-plug"
                                type="object"
                        />
                    </div>
                    <field name="api_key"
                           string="Key"
                           required="delivery_type == 'jtexpress'"
                    />
                    <!-- apiAccount: used in HTTP header -->
                    <field name="client_id"
                           string="API Account"
                           required="delivery_type == 'jtexpress'"
                    />
                    <!-- privateKey: used in HTTP header to compute digest -->
                    <field name="client_secret"
                           required="delivery_type == 'jtexpress'"
                           string="Private Key"
                    />
                    <!-- customerCode: used inside bizContent -->
                    <field name="partner_id"
                           string="Customer Code"
                           required="delivery_type == 'jtexpress'"
                    />
                    <label for="password"/>
                    <div class="o_row api_config_group">
                        <!-- password: used inside bizContent -->
                        <field name="password"/>
                        <button name="jtexpress_get_access_token"
                                string="Verify Credentials"
                                icon="fa-check-circle"
                                type="object"
                        />
                    </div>
                </group>
            </xpath>

            <!-- Default Shipment Parameters Block -->
            <xpath expr="//group[@name='delivery_default_shipment']" position="before">
                <group name="delivery_jtexpress_default_shipment"
                       invisible="delivery_type != 'jtexpress'"
                       string="Default Shipment Parameters"
                >
                    <field name="base_weight_unit"/>
                    <field name="default_promo_code"/>
                    <field name="default_jtexpress_payment_type"/>
                    <field name="default_jtexpress_order_type"/>
                    <field name="default_jtexpress_service_type"/>
                    <field name="default_jtexpress_product_type"/>
                    <field name="default_jtexpress_goods_type"/>
                </group>
            </xpath>

            <!-- Webhook Block -->
            <xpath expr="//group[@name='delivery_webhook']" position="before">
                <group name="delivery_jtexpress_webhook"
                       invisible="delivery_type != 'jtexpress'"
                       string="Webhook"
                >
                    <field name="webhook_url" widget="CopyClipboardChar" readonly="True"/>
                    <label for="is_use_authentication"/>
                    <div class="o_row">
                        <field name="is_use_authentication" widget="boolean_toggle"/>
                        <button name="action_generate_access_token"
                                string="Generate Access Token"
                                icon="oi-arrow-right"
                                type="object"
                                invisible="not is_use_authentication"
                        />
                    </div>
                    <field name="webhook_access_token"
                           invisible="not is_use_authentication"
                           widget="CopyClipboardChar"
                           readonly="True"
                    />
                </group>
            </xpath>

        </field>
    </record>
</odoo>
