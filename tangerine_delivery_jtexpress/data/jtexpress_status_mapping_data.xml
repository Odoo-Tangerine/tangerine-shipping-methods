<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- CREATED → Đã tạo đơn -->
        <record id="jtx_mapping_created" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_created"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_draft"/>
            <field name="sequence">10</field>
        </record>

        <!-- CANCELLED → Đã hủy -->
        <record id="jtx_mapping_cancelled" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_cancelled"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_cancelled"/>
            <field name="sequence">20</field>
        </record>

        <!-- PICKING_UP → Đang lấy hàng -->
        <record id="jtx_mapping_picking_up" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_picking_up"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_picking_up"/>
            <field name="sequence">30</field>
        </record>

        <!-- PICKED_UP → Đã lấy hàng -->
        <record id="jtx_mapping_picked_up" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_picked_up"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_picked_up"/>
            <field name="sequence">40</field>
        </record>

        <!-- ARRIVED_AT_SORTING_CENTER → Đang vận chuyển -->
        <record id="jtx_mapping_arrived_sorting" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_arrived_sorting_center"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_in_transit"/>
            <field name="sequence">50</field>
        </record>

        <!-- DEPARTURE_FROM_SORTING_CENTER → Đang vận chuyển -->
        <record id="jtx_mapping_departed_sorting" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_departed_sorting_center"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_in_transit"/>
            <field name="sequence">60</field>
        </record>

        <!-- ARRIVED_AT_DESTINATION_SORTING_CENTER → Đang vận chuyển -->
        <record id="jtx_mapping_arrived_dest_sorting" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_arrived_dest_sorting_center"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_in_transit"/>
            <field name="sequence">70</field>
        </record>

        <!-- IN_DELIVERY → Đang giao hàng -->
        <record id="jtx_mapping_in_delivery" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_in_delivery"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_delivering"/>
            <field name="sequence">80</field>
        </record>

        <!-- DELIVERED → Đã giao thành công -->
        <record id="jtx_mapping_delivered" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_delivered"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_delivered"/>
            <field name="sequence">90</field>
        </record>

        <!-- DELIVERY_FAILED → Ngoại lệ -->
        <record id="jtx_mapping_delivery_failed" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_delivery_failed"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_failed"/>
            <field name="sequence">100</field>
        </record>

        <!-- RETURNING → Đang chuyển hoàn -->
        <record id="jtx_mapping_returning" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_returning"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_returning"/>
            <field name="sequence">110</field>
        </record>

        <!-- RETURNED → Đã hoàn hàng -->
        <record id="jtx_mapping_returned" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_returned"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_returned"/>
            <field name="sequence">120</field>
        </record>

        <!-- EXCEPTION → Ngoại lệ -->
        <record id="jtx_mapping_exception" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_jtexpress.tangerine_delivery_jtexpress_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_jtexpress.jtexpress_status_exception"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_failed"/>
            <field name="sequence">130</field>
        </record>
    </data>
</odoo>
