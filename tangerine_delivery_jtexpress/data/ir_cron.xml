<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Placeholder cron – not active by default.
             J&T Express status updates are primarily received via Webhook push.
             Enable this cron only if you need polling fallback. -->
        <record id="ir_cron_jtexpress_sync_status" model="ir.cron">
            <field name="name">[J&amp;T Express]: Sync Delivery Status</field>
            <field name="model_id" ref="model_delivery_carrier"/>
            <field name="state">code</field>
            <field name="code">env['delivery.carrier']._cron_sync_jtexpress_status()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
            <field name="is_cron_delivery" eval="True"/>
        </record>
    </data>
</odoo>
