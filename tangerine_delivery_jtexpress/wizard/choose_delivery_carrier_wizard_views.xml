<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_choose_delivery_carrier_jtexpress" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.form.jtexpress</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <group invisible="carrier_id.delivery_type != 'jtexpress'"
                       name="jtexpress_wizard_params"
                       string="J&amp;T Express Options"
                >
                    <field name="jtexpress_payment_type"/>
                    <field name="jtexpress_order_type"/>
                    <field name="jtexpress_service_type"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
