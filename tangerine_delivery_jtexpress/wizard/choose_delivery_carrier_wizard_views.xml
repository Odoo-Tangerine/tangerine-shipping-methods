<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_choose_delivery_carrier_jtexpress" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.form.jtexpress</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form" />
        <field name="arch" type="xml">
            <field name="carrier_id" position="after">
                <field name="jtexpress_goods_type"
                       invisible="delivery_type != 'jtexpress'"
                       required="delivery_type == 'jtexpress'"
                />
                <label for="is_cod" invisible="delivery_type != 'jtexpress'"/>
                <div class="o_row" invisible="delivery_type != 'jtexpress'">
                    <field name="is_cod" style="max-width: 15%;" widget="boolean_toggle"/>
                    <field name="cod_amount" invisible="not is_cod"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
