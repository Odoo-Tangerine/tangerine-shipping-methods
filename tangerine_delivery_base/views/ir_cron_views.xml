<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_search_view_inherit" model="ir.ui.view">
        <field name="name">ir.cron.search.inherit.tangerine.delivery</field>
        <field name="model">ir.cron</field>
        <field name="inherit_id" ref="base.ir_cron_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='all']" position="before">
                <filter string="Delivery Crons" name="filter_cron_delivery" domain="[('is_cron_delivery', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="action_delivery_scheduled_actions" model="ir.actions.act_window">
        <field name="name">Scheduled Actions</field>
        <field name="res_model">ir.cron</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_filter_cron_delivery': True, 'search_default_all': 1}</field>
        <field name="view_id" ref="base.ir_cron_view_tree"/>
    </record>
</odoo>
