<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form_inherit_delivery_nhat_tin" model="ir.ui.view">
        <field name="name">view.picking.withcarrier.out.form.inherit.delivery.nhat.tin</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="tangerine_delivery_base.view_picking_withcarrier_out_form_inherit_delivery_base"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='external_delivery_data']" position="before">
                <group name='delivery_nhat_tin_data'
                       invisible="carrier_tracking_ref or not is_locally_delivery or delivery_type != 'nhat_tin'"
                       string="Nhat Tin Logistics Information"
                >
                    <label for="cash_on_delivery" name="o_label_cash_on_delivery"/>
                    <div class="o_row" name="o_div_cash_on_delivery">
                        <field name="cash_on_delivery" style="max-width: 15%;" widget="boolean_toggle" readonly="carrier_tracking_ref"/>
                        <field name="cash_on_delivery_amount" readonly="carrier_tracking_ref" invisible="not cash_on_delivery"/>
                    </div>
                    <field name="ntl_service_type" required="delivery_type == 'nhat_tin'" invisible="delivery_type != 'nhat_tin'"/>
                    <field name="ntl_payment_method" required="delivery_type == 'nhat_tin'" invisible="delivery_type != 'nhat_tin'"/>
                    <field name="ntl_cargo_type" invisible="delivery_type != 'nhat_tin'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>