<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Lalamove: ASSIGNING_DRIVER → Đã xác nhận -->
        <record id="lalamove_mapping_assigning_driver" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_lalamove.tangerine_delivery_lalamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_lalamove.lalamove_status_assigning_driver"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_confirmed"/>
            <field name="sequence">10</field>
        </record>

        <!-- Lalamove: ON_GOING → Đang lấy hàng -->
        <record id="lalamove_mapping_on_going" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_lalamove.tangerine_delivery_lalamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_lalamove.lalamove_status_on_going"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_picking_up"/>
            <field name="sequence">20</field>
        </record>

        <!-- Lalamove: PICKED_UP → Đang vận chuyển -->
        <record id="lalamove_mapping_picked_up" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_lalamove.tangerine_delivery_lalamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_lalamove.lalamove_status_picked_up"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_in_transit"/>
            <field name="sequence">30</field>
        </record>

        <!-- Lalamove: COMPLETED → Đã giao thành công -->
        <record id="lalamove_mapping_completed" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_lalamove.tangerine_delivery_lalamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_lalamove.lalamove_status_completed"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_delivered"/>
            <field name="sequence">40</field>
        </record>

        <!-- Lalamove: CANCELED → Đã hủy -->
        <record id="lalamove_mapping_canceled" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_lalamove.tangerine_delivery_lalamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_lalamove.lalamove_status_canceled"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_cancelled"/>
            <field name="sequence">50</field>
        </record>

        <!-- Lalamove: REJECTED → Thất bại -->
        <record id="lalamove_mapping_rejected" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_lalamove.tangerine_delivery_lalamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_lalamove.lalamove_status_rejected"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_failed"/>
            <field name="sequence">60</field>
        </record>

        <!-- Lalamove: EXPIRED → Đã hủy -->
        <record id="lalamove_mapping_expired" model="delivery.status.mapping">
            <field name="provider_id" ref="tangerine_delivery_lalamove.tangerine_delivery_lalamove_provider"/>
            <field name="carrier_status_id" ref="tangerine_delivery_lalamove.lalamove_status_expired"/>
            <field name="standard_status_id" ref="tangerine_delivery_base.standard_status_cancelled"/>
            <field name="sequence">70</field>
        </record>
    </data>
</odoo>
