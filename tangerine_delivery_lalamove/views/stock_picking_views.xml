<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form_inherit_delivery_lalamove" model="ir.ui.view">
        <field name="name">view.picking.withcarrier.out.form.inherit.delivery.lalamove</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="tangerine_delivery_base.view_picking_withcarrier_out_form_inherit_delivery_base"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='external_delivery_data']" position="before">
                <group name='delivery_lalamove_data'
                       invisible="carrier_tracking_ref or not is_locally_delivery or delivery_type != 'lalamove' or lalamove_got_quotation"
                       string="Lalamove Shipping Information"
                >
                    <field name="lalamove_got_quotation" invisible="1"/>
                    <field name="lalamove_special_service_domain" invisible="1"/>
                    <field name="is_lalamove_goods_fragile" widget="boolean_toggle"/>
                    <field name="lalamove_service_id"
                           required="delivery_type == 'lalamove' and not lalamove_got_quotation"
                           options="{'no_create_edit': True}"
                    />
                    <field name="lalamove_special_service_ids"
                           widget="many2many_tags"
                           domain="lalamove_special_service_domain"
                           options="{'no_create_edit': True}"
                    />
                    <label for="schedule_order" name="o_label_schedule_order"/>
                    <div class="o_row" name="o_schedule_order">
                        <field name="schedule_order" style="max-width: 15%;" widget="boolean_toggle" readonly="carrier_tracking_ref"/>
                        <field name="schedule_pickup_time_to"
                               invisible="not schedule_order"
                               required="schedule_order"
                               readonly="carrier_tracking_ref"
                        />
                    </div>
                    <field name="remarks"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>